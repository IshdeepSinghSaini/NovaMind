# ============================================================
# NovaMind settings - EXAMPLE FILE
# Copy this file, rename the copy to ".env", and fill in real values.
# The real ".env" file is never uploaded to GitHub.
# ============================================================

# ---- Flask ----
FLASK_ENV=development
# A long random text used to sign login tokens. Change it!
SECRET_KEY=change-me-to-a-long-random-text

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=novamind_db
DB_USER=postgres
DB_PASSWORD=your-database-password-here

# ---- Documents and chunking ----
# Biggest file an admin may upload (checked before the file is even read)
MAX_UPLOAD_MB=10
# Characters per chunk. Keep <= ~900 so chunks fit the embedding model (256 tokens).
CHUNK_SIZE=800
# Characters repeated between neighbouring chunks
CHUNK_OVERLAP=150

# ---- Embeddings and vector store ----
# Runs locally (free). Downloaded once (~90 MB) on first use.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_COLLECTION=novamind_chunks

# ---- AI (used from Phase 9) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# ---- Test user password (development only) ----
# Leave empty: scripts/create_sample_users.py will generate one and save it here.
SEED_USER_PASSWORD=
